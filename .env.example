NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=        # not used by the app (account deletion uses a DB function)
DATABASE_URL=                     # transaction pooler (6543) as openprep_app — see README
MIGRATE_DATABASE_URL=             # session pooler (5432) as postgres; only for db:migrate
NEXT_PUBLIC_SITE_URL=http://localhost:3000
AI_MODEL=                         # empty = the selected provider's default model
ANTHROPIC_API_KEY=
AI_DAILY_LIMIT=30
NEXT_PUBLIC_DESMOS_API_KEY=       # empty → hosted Desmos embed (enter lesson expressions manually)
DEV_USER_ID=                      # next dev only: sign in as this uuid without auth
NEXT_PUBLIC_GOOGLE_CLIENT_ID=              # public Google OAuth web client id (Google Identity Services button)
# AI tutor provider: anthropic (default) | openai | google | openrouter | local. AI_MODEL must match the provider
# (empty → small default: claude-haiku-4-5-20251001 / gpt-5-mini / gemini-2.5-flash / anthropic/claude-haiku-4.5 / llama3.2).
AI_PROVIDER=anthropic
OPENAI_API_KEY=
GOOGLE_GENERATIVE_AI_API_KEY=
OPENROUTER_API_KEY=
AI_BASE_URL=                      # local only: OpenAI-compatible endpoint, e.g. Ollama http://localhost:11434/v1 (no key)
NEXT_PUBLIC_VAPID_PUBLIC_KEY=              # web push (npx web-push generate-vapid-keys)
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:you@example.com
CRON_SECRET=                              # protects /api/cron/reminders
